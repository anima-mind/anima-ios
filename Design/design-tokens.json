{
  "$schema": "anima design tokens v1 — dark only",
  "color": {
    "bg": "#1d2d3d",
    "surface": "#243849",
    "border": "#2c455d",
    "text": "#f5f5f8",
    "textMuted": "#b7c4d2",
    "textFaint": "#8aa0b6",
    "accent": "#94bce3",
    "accentText": "#d6ebff",
    "tint": "rgba(148,188,227,0.12)",
    "scrim": "rgba(0,0,0,0.45)",
    "hud": { "ink": "#e8f3ff", "inkMuted": "#b7d3ee", "halo": "rgba(148,188,227,0.6)" },
    "rule": "No red, no green. Errors and refusals use the same palette; state is carried by weight, opacity and copy."
  },
  "type": {
    "family": "SF Pro Text / SF Pro Display (system). Fallback: Inter, system-ui.",
    "weights": [400, 500],
    "scale": {
      "hero": { "size": 28, "weight": 500, "tracking": -0.015, "lineHeight": 1.15 },
      "screenTitle": { "size": 24, "weight": 500, "tracking": -0.015 },
      "cardTitle": { "size": 16, "weight": 500, "lineHeight": 1.3 },
      "body": { "size": 15, "weight": 400, "lineHeight": 1.5 },
      "secondary": { "size": 13, "weight": 400, "lineHeight": 1.45 },
      "meta": { "size": 12, "weight": 400 },
      "label": { "size": 11, "weight": 400, "tracking": 0.06, "transform": "uppercase" },
      "tab": { "size": 10, "weight": 400, "tracking": 0.02 }
    },
    "numerals": "tabular-nums wherever plasticity or money appears"
  },
  "space": { "unit": 4, "screenInset": 20, "stack": 12, "cardPad": 14, "sectionGap": 20, "tabBarBottom": 30 },
  "radius": { "control": 8, "card": 8, "chip": 6, "sheet": 16, "appIcon": "iOS squircle" },
  "stroke": { "hairline": 1, "icon": 1.5, "mark": 2.4 },
  "hitTarget": { "min": 44 },
  "rule": {
    "fading": "linear-gradient(90deg, transparent, border 48px, border calc(100% - 48px), transparent)",
    "note": "Dividers fade at both ends; only card borders run edge to edge."
  },
  "motion": {
    "enter": { "duration": 300, "easing": "ease-out", "transform": "translateY(6px) → 0, opacity 0 → 1" },
    "sheet": { "duration": 250, "easing": "ease-out" },
    "streamCaret": { "duration": 1000, "steps": 1 },
    "thinkingPulse": { "duration": 1400, "easing": "ease-in-out", "opacity": [0.35, 1] },
    "voiceWave": { "duration": 900, "stagger": 150 },
    "plasticity": { "duration": 600, "note": "ring / wave amplitude interpolate when cycles change" }
  },
  "plasticity": {
    "formula": "p(n) = 0.05 + 0.95 * exp(-n / 30)",
    "regimes": { "bootstrap": ">= 0.7", "adolescence": "0.3 – 0.7", "maturity": "< 0.3" },
    "badge": "44×2px bar, accent filled to p, label `p 0.42 · adolescence`"
  },
  "mark": {
    "name": "Breath",
    "viewBox": "0 0 96 96",
    "restLine": "M18 50h60",
    "wave": "M18 50c8 0 8 A 16 A s8 -2A 16 -2A 8 2A 16 2A 8 -A 12 -A",
    "amplitude": "A = 4 + 14 * p   (18 at birth, 4.7 at maturity)",
    "dot": { "cx": 48, "cy": 50, "r": 2.8, "fill": "text" },
    "stroke": "horizontal gradient accent 15% → accentText → accent 15%",
    "glow": "radial ellipse 30×14 at (48,50), accent, opacity 0.2 + 0.4 * p",
    "iconBackground": "radial-gradient(#2c455d at 50% 60%, #101b26)"
  }
}
